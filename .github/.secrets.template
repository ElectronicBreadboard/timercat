# GitHub Secrets Template
# 
# Copy this template and add the actual values to your GitHub repository secrets.
# Go to: Settings → Secrets and variables → Actions → New repository secret

# ============================================
# macOS Code Signing (Required for macOS builds)
# ============================================

# Export your Developer ID Application certificate from Keychain Access as .p12
# Then base64 encode it: base64 -i certificate.p12 | pbcopy
APPLE_CERTIFICATE=

# Password you set when exporting the .p12 certificate
APPLE_CERTIFICATE_PASSWORD=

# Your Apple ID email (used for notarization)
APPLE_ID=

# App-specific password for notarization
# Generate at: https://appleid.apple.com → Security → App-Specific Passwords
APPLE_PASSWORD=

# Your Apple Developer Team ID (10 characters)
# Find at: https://developer.apple.com/account → Membership
APPLE_TEAM_ID=

# ============================================
# GitHub (Automatically provided - no setup required)
# ============================================

# GitHub automatically provides this token for each workflow run
# GITHUB_TOKEN=

# ============================================
# Future: Windows Code Signing
# ============================================

# WINDOWS_CERTIFICATE=
# WINDOWS_CERTIFICATE_PASSWORD=

