{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Focuscat",
	"version": "0.0.27",
	"mainBinaryName": "Focuscat",
	"identifier": "com.buildergroup.focuscat",
	"build": {
		"features": [
			"app-store"
		]
	},
	"app": {
		"macOSPrivateApi": false
	},
	"bundle": {
