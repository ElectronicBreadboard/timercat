{
	"name": "desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tauri build",
		"clean": "shx rm -rf target && shx rm -rf build && shx rm -rf .react-router && shx rm -rf .turbo && shx rm -rf node_modules",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint . --fix",
		"start:dev": "tauri dev",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit",
		"ui:build": "pnpm typecheck && vite build",
		"ui:start:dev": "vite dev",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	}
}
